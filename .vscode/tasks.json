{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NAMI: crear entorno Python",
      "type": "process",
      "command": "python3",
      "args": ["-m", "venv", "${workspaceFolder}/.venv"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "NAMI: instalar dependencias",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pip", "install", "-r", "${workspaceFolder}/nami_service/requirements.txt"],
      "dependsOn": "NAMI: crear entorno Python",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "NAMI: pruebas",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "unittest", "nami_service.test_service", "-v"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "NAMI: proxy HTTPS local",
      "type": "process",
      "command": "caddy",
      "args": ["run", "--config", "${workspaceFolder}/dev/Caddyfile"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "NAMI_PUBLIC_ROOT": "${workspaceFolder}" }
      },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    }
  ]
}
