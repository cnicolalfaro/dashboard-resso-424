{
	admin off
	auto_https disable_redirects
}

https://localhost:8443 {
	bind 127.0.0.1 ::1
	tls internal

	@api path /api/nami /api/nami/*
	handle @api {
		reverse_proxy 127.0.0.1:8001
	}

	@frontend path /nami/ /nami/index.html /nami/app.js /nami/style.css
	handle @frontend {
		root * {$NAMI_PUBLIC_ROOT}
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "no-referrer"
		file_server
	}

	handle / {
		redir /nami/ 302
	}

	handle {
		respond "Not found" 404
	}
}
